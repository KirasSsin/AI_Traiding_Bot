# Bybit API (testnet defaults are hardcoded in Settings; uncomment to override)
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# TESTNET=true

# Runtime flags
TRADING_ENABLED=false
LIVE_TRADING=false

# Paths
DATA_DIR=./data
LOG_DIR=./logs
DB_PATH=./data/bot.db
PARQUET_DIR=./data/parquet

# Observability
# SENTRY_DSN=
LOG_LEVEL=INFO
