# Binance (testnet для S2-S9, mainnet только в S10)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=testnet

# Runtime flags
TRADING_ENABLED=false
LIVE_TRADING=false

# Paths (relative to repo root)
DATA_DIR=./data
LOG_DIR=./logs
DB_PATH=./data/oltp.db
PARQUET_DIR=./data/parquet

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=INFO
